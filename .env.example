# =============================================================================
# Portal dos Links — Environment Variables
# Copy this file to .env and fill in the values for local development.
# Never commit a .env file — only this .env.example should be tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (required)
# PostgreSQL connection string consumed by Prisma.
# Example: postgres://user:password@localhost:5432/portal_dos_links
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/portal_dos_links

# -----------------------------------------------------------------------------
# OpenTelemetry — Traces & Metrics
#
# OTEL_EXPORTER_OTLP_ENDPOINT (required in production)
#   gRPC endpoint of the OpenTelemetry Collector that receives traces and
#   metrics from the API.
#   Example (local collector via docker-compose): http://localhost:4317
#   Leave empty in local dev if you don't need traces.
#
# OTEL_SERVICE_NAME (optional)
#   Logical name that identifies this service in traces and metrics.
#   Defaults to "portal-dos-links-api" when not set.
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=portal-dos-links-api

# -----------------------------------------------------------------------------
# API server (optional)
# Port the NestJS/Fastify server listens on.
# Defaults to 3000 when not set.
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Frontend (Vite)
# Base URL of the API, consumed by the frontend via import.meta.env.VITE_API_URL.
# Defaults to http://localhost:3000 in local dev.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000
